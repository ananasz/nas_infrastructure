# Shell syntax; root-owned, chmod 0600. Never commit real credentials.
RESTIC_REPOSITORY='rclone:filen:nas-backup'
RESTIC_PASSWORD_FILE='/opt/compose/backup/secrets/restic-password'
RCLONE_CONFIG='/opt/compose/backup/secrets/rclone.conf'
RESTIC_CACHE_DIR='/var/cache/nas-backup'
# Exact ZFS dataset whose mountpoint contains photos (no child datasets there).
PHOTOS_DATASET='REPLACE_WITH_ZFS_DATASET'
PHOTOS_PATH='/nas-data/zfs-pool/photos'
