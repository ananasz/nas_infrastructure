# Single quotes keep "$" literal (hashes). The PEM goes in double quotes over several lines.
JWT_SECRET=''
SESSION_SECRET=''
# Must match the existing DB; a different key prevents Authelia from starting.
STORAGE_ENCRYPTION_KEY=''
OIDC_HMAC_SECRET=''
OIDC_JWKS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
-----END PRIVATE KEY-----"
# Authelia hash of the cetli-backend client secret (cetli/.env OIDC_CLIENT_SECRET).
CETLI_CLIENT_SECRET_HASH=''
# Authelia hash of the anachronos-backend client secret (anachronos/.env OIDC_CLIENT_SECRET).
ANACHRONOS_CLIENT_SECRET_HASH=''
# SMTP2GO SMTP user of this service (docs/EMAIL.md).
SMTP_USERNAME=
SMTP_PASSWORD=''
