# Image tags; latest unless a release is pinned (build-docker.bat tag: yyyyMMdd-HHmm-<rev>).
ANACHRONOS_BACKEND_TAG=latest
ANACHRONOS_FRONTEND_TAG=latest

POSTGRES_DB=anachronos
POSTGRES_USER=anachronos

APP_ORIGIN=https://chrono.ananasz.hu
APP_TIMEZONE=Europe/Budapest

OIDC_ISSUER_URL=https://auth.ananasz.hu
OIDC_CLIENT_ID=anachronos-backend
OIDC_ACCESS_GROUPS=access_anachronos
OIDC_ADMIN_GROUPS=admin_anachronos,superadmin

# Secrets (single quotes keep "$" literal). Generate new ones, do not reuse cetli or local values.
POSTGRES_PASSWORD=''
# Raw client secret; its hash goes to auth/.env ANACHRONOS_CLIENT_SECRET_HASH.
OIDC_CLIENT_SECRET=''
# At least 32 random characters.
COOKIE_SECRET=''
