{
  "id": null,
  "uid": "nas-crowdsec",
  "title": "CrowdSec",
  "description": "CrowdSec tiltások, észlelések és logfeldolgozás (docs/SECURITY.md).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "nas"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Container LOGS",
      "type": "link",
      "url": "/d/nas-container-logs",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "CrowdSec",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nas-metrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nas-metrics"
          },
          "refId": "A",
          "expr": "max(up{job=\"crowdsec\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "nincs adat",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Firewall bouncer",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nas-metrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nas-metrics"
          },
          "refId": "A",
          "expr": "max(up{job=\"crowdsec-firewall-bouncer\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "nincs adat",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Aktív tiltások forrás szerint",
      "description": "crowdsec: helyi észlelés; CAPI/lists: közösségi blokklista; cscli: kézi.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nas-metrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nas-metrics"
          },
          "refId": "A",
          "expr": "sum by (origin) (cs_active_decisions)",
          "legendFormat": "{{origin}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Helyi észlelések scenario szerint",
      "description": "Betelt bucketek; mindegyik egy riasztás és (remediation esetén) egy tiltás.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nas-metrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nas-metrics"
          },
          "refId": "A",
          "expr": "sum by (name) (increase(cs_bucket_overflowed_total[$__interval]))",
          "legendFormat": "{{name}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Feldolgozott logsorok",
      "description": "ko: a parser nem ismerte fel a sort. Az nginx error logja és a nem belépési sorok ide kerülnek, ez normális; ha az ok 0, a parser vagy az acquisition hibás.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nas-metrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nas-metrics"
          },
          "refId": "A",
          "expr": "sum by (source) (rate(cs_parser_hits_ok_total[$__rate_interval]))",
          "legendFormat": "ok {{source}}",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "nas-metrics"
          },
          "refId": "B",
          "expr": "sum by (source) (rate(cs_parser_hits_ko_total[$__rate_interval]))",
          "legendFormat": "ko {{source}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5
    },
    {
      "type": "logs",
      "title": "Riasztások és tiltások (CrowdSec log)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "nas-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "nas-loki"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "{host=\"nas\", container=\"crowdsec\"} |~ \"performed|ban on|whitelisted\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "id": 6
    }
  ]
}
