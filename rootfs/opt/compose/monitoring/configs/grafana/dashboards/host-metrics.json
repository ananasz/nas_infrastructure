{
  "id": null,
  "uid": "nas-host-metrics",
  "title": "Metrics",
  "description": "VictoriaMetrics; Host & Docker",
  "schemaVersion": 39,
  "version": 6,
  "editable": true,
  "tags": [
    "nas",
    "metrics",
    "vps",
    "docker"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Container STATS",
      "type": "link",
      "url": "/d/nas-container-stats",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Disks",
      "type": "link",
      "url": "/d/nas-disks",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Container LOGS",
      "type": "link",
      "url": "/d/nas-container-logs",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nas-metrics"
        },
        "query": "label_values(up{job=~\"node|cadvisor\"}, host)",
        "definition": "label_values(up{job=~\"node|cadvisor\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "compose_project",
        "label": "Compose project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nas-metrics"
        },
        "query": "label_values(container_cpu_usage_seconds_total{host=~\"$host\"}, compose_project)",
        "definition": "label_values(container_cpu_usage_seconds_total{host=~\"$host\"}, compose_project)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "compose_service",
        "label": "Compose service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nas-metrics"
        },
        "query": "label_values(container_cpu_usage_seconds_total{host=~\"$host\",compose_project=~\"$compose_project\"}, compose_service)",
        "definition": "label_values(container_cpu_usage_seconds_total{host=~\"$host\",compose_project=~\"$compose_project\"}, compose_service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Host CPU (%)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "nas-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{job=\"node\",host=~\"$host\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{host}}",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "nas-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
