      "targets": [
        {
          "refId": "A",
          "expr": "100 * (node_memory_SwapTotal_bytes{job=\"node\",host=~\"$host\"} - node_memory_SwapFree_bytes{job=\"node\",host=~\"$host\"}) / clamp_min(node_memory_SwapTotal_bytes{job=\"node\",host=~\"$host\"}, 1)",
          "legendFormat": "{{host}}",
          "editorMode": "code",
          "range": true,
          "datasource": {
